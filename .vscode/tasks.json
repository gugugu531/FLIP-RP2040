{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Project",
            "type": "process",
            "command": "${userHome}/.pico-sdk/cmake/v3.31.5/bin/cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-G",
                "Ninja",
                "-DCMAKE_MAKE_PROGRAM=${userHome}/.pico-sdk/ninja/v1.12.1/ninja",
                "-DPENDANT_USE_PICO_VSCODE=ON"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "windows": {
                "command": "${userHome}/.pico-sdk/cmake/v3.31.5/bin/cmake.exe",
                "args": [
                    "-S",
                    "${workspaceFolder}",
                    "-B",
                    "${workspaceFolder}/build",
                    "-G",
                    "Ninja",
                    "-DCMAKE_MAKE_PROGRAM=${userHome}/.pico-sdk/ninja/v1.12.1/ninja.exe",
                    "-DPENDANT_USE_PICO_VSCODE=ON"
                ]
            }
        },
        {
            "label": "Compile Project",
            "type": "process",
            "command": "${userHome}/.pico-sdk/ninja/v1.12.1/ninja",
            "args": [
                "-C",
                "${workspaceFolder}/build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": "Configure Project",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "windows": {
                "command": "${userHome}/.pico-sdk/ninja/v1.12.1/ninja.exe"
            }
        },
        {
            "label": "Run Project",
            "type": "process",
            "command": "${command:raspberry-pi-pico.getPicotoolPath}",
            "args": [
                "load",
                "${workspaceFolder}/build/flip_rp2040.elf",
                "-fx"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "Compile Project"
        },
        {
            "label": "Flash",
            "type": "process",
            "command": "${command:raspberry-pi-pico.getOpenOCDRoot}/openocd",
            "args": [
                "-s",
                "${command:raspberry-pi-pico.getOpenOCDRoot}/scripts",
                "-f",
                "interface/cmsis-dap.cfg",
                "-f",
                "target/rp2040.cfg",
                "-c",
                "adapter speed 5000; program \"${workspaceFolder}/build/flip_rp2040.elf\" verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "Compile Project",
            "windows": {
                "command": "${command:raspberry-pi-pico.getOpenOCDRoot}/openocd.exe"
            }
        }
    ]
}
